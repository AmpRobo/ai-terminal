[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=AI Terminal
GenericName=TerminalEmulator

Exec=ai-terminal-oss %U
StartupWMClass=dev.aiterminal.AiTerminalOss

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.aiterminal.AiTerminalOss

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for aiterminaloss:// URLs.
MimeType=x-scheme-handler/aiterminaloss;
