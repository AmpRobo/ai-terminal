[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=AiTerminalPreview
GenericName=TerminalEmulator

Exec=ai-terminal-preview %U
StartupWMClass=dev.aiterminal.AiTerminalPreview

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.aiterminal.AiTerminalPreview

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for aiterminalpreview:// URLs.
MimeType=x-scheme-handler/aiterminalpreview;
