#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/ai-terminal@@CHANNEL_SUFFIX@@-flags.conf ]]; then
    AI_TERMINAL_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/ai-terminal@@CHANNEL_SUFFIX@@-flags.conf)"
fi

# Launch
exec /opt/aiterminal/ai-terminal@@CHANNEL_SUFFIX@@/@@BINARY_NAME@@ $AI_TERMINAL_USER_FLAGS "$@"
