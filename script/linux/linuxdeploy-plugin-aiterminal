#!/bin/bash
#
# linuxdeploy input plugin for restructuring the AppDir to match AI Terminal's
# standard Linux install layout.
#
# By default, linuxdeploy places the executable at usr/bin/ inside the AppDir.
# This plugin moves it to opt/aiterminal/<package>/ (matching deb/rpm/arch
# package layout), creates a symlink from usr/bin/ to the new location, and
# copies bundled resources alongside the binary.
#
# This means that extracting an AppImage produces the same filesystem layout
# as installing a .deb or .rpm package.
#
# Required environment variables:
#   AI_TERMINAL_BINARY_NAME:           Name of the binary (e.g. "ai-terminal-dev").
#   AI_TERMINAL_PACKAGE_NAME:          Package directory name (e.g. "ai-terminal-dev").
#   AI_TERMINAL_BUNDLED_RESOURCES_DIR: Path to the staged resources directory to copy.

set -e

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --plugin-api-version)
      echo "0"
      exit 0
      ;;
    --appdir)
      APPDIR="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$APPDIR" ]; then
  echo "ERROR: --appdir is required" >&2
  exit 1
fi

for var in AI_TERMINAL_BINARY_NAME AI_TERMINAL_PACKAGE_NAME AI_TERMINAL_BUNDLED_RESOURCES_DIR; do
  if [ -z "${!var}" ]; then
    echo "ERROR: $var environment variable is not set" >&2
    exit 1
  fi
done

if [ ! -d "$AI_TERMINAL_BUNDLED_RESOURCES_DIR" ]; then
  echo "ERROR: Bundled resources directory does not exist: $AI_TERMINAL_BUNDLED_RESOURCES_DIR" >&2
  exit 1
fi

SRC_BIN="$APPDIR/usr/bin/$AI_TERMINAL_BINARY_NAME"
if [ ! -f "$SRC_BIN" ]; then
  echo "ERROR: Expected binary not found at $SRC_BIN" >&2
  exit 1
fi

# Create the /opt install directory inside the AppDir.
OPT_DIR="$APPDIR/opt/aiterminal/$AI_TERMINAL_PACKAGE_NAME"
mkdir -p "$OPT_DIR"

# Move the binary from usr/bin/ to opt/aiterminal/<package>/.
echo "Relocating binary to $OPT_DIR/$AI_TERMINAL_BINARY_NAME"
mv "$SRC_BIN" "$OPT_DIR/$AI_TERMINAL_BINARY_NAME"

# Create a relative symlink so usr/bin/<name> still resolves to the binary.
# From usr/bin/ to opt/aiterminal/<package>/ is ../../opt/aiterminal/<package>/.
echo "Creating symlink at usr/bin/$AI_TERMINAL_BINARY_NAME"
ln -s "../../opt/aiterminal/$AI_TERMINAL_PACKAGE_NAME/$AI_TERMINAL_BINARY_NAME" "$SRC_BIN"

# Copy bundled resources alongside the binary.
DEST_RESOURCES="$OPT_DIR/resources"
echo "Copying bundled resources to $DEST_RESOURCES"
mkdir -p "$DEST_RESOURCES"
cp -R "$AI_TERMINAL_BUNDLED_RESOURCES_DIR/." "$DEST_RESOURCES/"

# linuxdeploy publishes the AppImage icon as a symlink chain. Thumbnailers that
# do not follow symlinks keep the generic executable icon (a gear) instead of the logo.
materialize_appimage_icon() {
  local root_icon="" icon_base="" best="" candidate="" size=""
  root_icon="$(find "$APPDIR" -maxdepth 1 -type l -name '*.png' -print -quit)"
  if [[ -z "$root_icon" ]]; then
    root_icon="$(find "$APPDIR" -maxdepth 1 -type f -name '*.png' -print -quit)"
  fi
  if [[ -z "$root_icon" ]]; then
    return 0
  fi

  icon_base="$(basename "$root_icon")"
  for size in 256x256 512x512 128x128 64x64 48x48 32x32 16x16; do
    candidate="$APPDIR/usr/share/icons/hicolor/$size/apps/$icon_base"
    if [[ -f "$candidate" ]]; then
      best="$candidate"
      break
    fi
  done
  if [[ -z "$best" && -L "$root_icon" ]]; then
    best="$(readlink -f "$root_icon" || true)"
  fi
  if [[ ! -f "$best" ]]; then
    return 0
  fi

  rm -f "$APPDIR/.DirIcon" "$root_icon"
  cp "$best" "$APPDIR/.DirIcon"
  cp "$best" "$root_icon"
}
materialize_appimage_icon

echo "Successfully restructured AppDir for AI Terminal"
