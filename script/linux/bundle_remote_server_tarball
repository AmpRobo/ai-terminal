#!/usr/bin/env bash
#
# Builds a remote-server tarball as part of the bundling process.
#
# The tarball uses the layout of the CLI tarballs served by /download/cli, which is what
# crates/remote_server/src/install_remote_server.sh expects: an executable whose name starts with
# `oz`, next to the artifact's `resources/` tree. The client uploads it to SSH hosts over SCP when
# it cannot download the remote server instead.
#
# Required environment variables:
#   - DIST_DIR: A temporary directory we can use for staging files as we build the package.
#   - OUT_DIR: The directory into which we should place the final package.
#   - EXECUTABLE_PATH: The path to the compiled CLI executable.
#   - BUNDLED_RESOURCES_DIR: The prepared bundled resources directory for the CLI.
#   - BUILD_ARCH: The architecture the executable was built for (x86_64 or aarch64).
#
# Optional environment variables:
#   - REMOTE_SERVER_TARBALLS_DIR: The directory under which to write linux-<arch>/oz.tar.gz.
#     Defaults to $OUT_DIR/remote-server.

set -e

STAGE_DIR="$DIST_DIR/remote-server-tarball"
TARBALL_PATH="${REMOTE_SERVER_TARBALLS_DIR:-$OUT_DIR/remote-server}/linux-$BUILD_ARCH/oz.tar.gz"

cleanup() {
  rm -rf "$STAGE_DIR"
}
trap cleanup EXIT

rm -rf "$STAGE_DIR"
mkdir -p "$STAGE_DIR" "$(dirname "$TARBALL_PATH")"
cp "$EXECUTABLE_PATH" "$STAGE_DIR/oz"
cp -R "$BUNDLED_RESOURCES_DIR" "$STAGE_DIR/resources"
# tar run as root on the remote restores archived owners and modes, and the install script moves
# the extracted files into place, so none may stay owned or writable by the build machine's user.
tar --owner=0 --group=0 --numeric-owner --mode=go-w -czf "$TARBALL_PATH" -C "$STAGE_DIR" oz resources

echo "Successfully built remote-server tarball at $TARBALL_PATH!"
